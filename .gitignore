# uv / virtualenv
.venv/

# Python build & cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
# Anchored to the repo root: setuptools writes ./build, but an unanchored
# pattern also swallows docker/build/, which holds the Dockerfile.
/build/
/dist/

# test & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/

# IDE
.idea/

# local Postgres data (docker-compose volume)
postgres-db/
# local configuration (./chesssnake.toml is the first discovery candidate)
/chesssnake.toml
