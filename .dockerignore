# Keep the build context small and the image reproducible. The Dockerfile copies
# only pyproject.toml, README.md, LICENSE and src/, but everything sent to the
# daemon still costs time — and .venv alone is hundreds of megabytes.

.venv/
venv/
.git/
.github/
postgres-db/
dist/
build/
*.egg-info/
src/*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
tests/
docs/
examples/
docker/
*.db
*.db-wal
*.db-shm
chesssnake.toml
.env
